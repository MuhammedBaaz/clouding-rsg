# Copy to .env (same folder as server.py) and fill in the authorised SMTP
# account. server.py reads this file at start; values already present in
# the process environment win. Never commit or share the filled-in file.
OTP_SMTP_HOST=smtp.example.com
OTP_SMTP_PORT=587
OTP_SMTP_SECURITY=starttls
OTP_SMTP_USER=sender@example.com
OTP_SMTP_PASSWORD=
OTP_SMTP_FROM=Red Sea Concierge <sender@example.com>
OTP_ALLOWED_RECIPIENTS=muhammed.baz@clouding.ai

# Saved guest profiles for returning customers (optional). A JSON file that is
# never served to the browser; read only for an e-mail verified with a code.
# Format: {"profiles": {"name@domain": {"title": "", "firstName": "", "familyName": "",
#          "mobileCode": "+966", "mobile": "", "guest2First": "", "guest2Family": ""}}}
# Default when unset: private/profiles.json, created at start from
# private/profiles.seed.json (the approved demo account, inserted once and
# never overwritten). Special requests are never stored in a profile.
# PROFILE_STORE=private/profiles.json

# ---- Live concierge (Claude Managed Agent) ----
# Console API key: https://platform.claude.com/settings/keys (secret; set locally, never commit)
ANTHROPIC_API_KEY=
# Printed by `python tools/console_setup.py` after it creates (or finds) the agent and its environment
ANTHROPIC_AGENT_ID=
ANTHROPIC_ENVIRONMENT_ID=
# Model the agent runs on (also used by console_setup.py when creating the agent)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tests only: 1 replaces Claude with a local keyword stand-in and prints a banner. Leave unset for the live agent.
# LIVE_AGENT_TEST_DOUBLE=

# ---- Empathy Studio web widget (optional) ----
# When set, the page loads Studio's chat widget for this channel and hides the RSG launcher (?chat=rsg restores it).
# The channel's browser key comes from the channel page in Studio (acp_...). Allowed origins on that channel must
# include this page's origin, e.g. http://127.0.0.1:8100
STUDIO_CHANNEL_KEY=
STUDIO_SSE_ENDPOINT=https://acp-test.clouding.ai/api/v1/chat
STUDIO_SDK_URL=https://cdn.clouding.ai/sdk/web/next/core.min.js
# STUDIO_AVATAR_URL=   (default: this origin's /assets/logos/vrs-turtle-mark.svg)
# Custom Agent bridge (Studio agent type "Custom Agent", Base URL = https://<public host of this server>/studio):
# optional shared secret that Studio must send as the header X-Bridge-Key (Secret Headers on the Studio agent), and the
# public origin for card images when the server sits behind a tunnel/proxy without X-Forwarded-Proto.
# STUDIO_BRIDGE_SECRET=
# STUDIO_ASSET_ORIGIN=https://<public host>

# ---- Demo loyalty points (agent/loyalty.py; demo rules, not RSG programme) ----
# LOYALTY_EARN_SAR_PER_POINT=10      (1 point per SAR 10 of the amount payable, rounded down)
# LOYALTY_REDEEM_SAR_PER_POINT=0.10  (1 point = SAR 0.10 off the next demo booking)
# LOYALTY_STORE=private/loyalty.json

# ---- Shared spend cap for the RSG Managed Agent (agent/budget.py) ----
# Counted from the owner's budget instruction; platform list cost (cents) of every session of the agent since then.
# AGENT_BUDGET_USD=2.00
# AGENT_BUDGET_START=2026-11-10T13:31:15Z
# AGENT_SPEND_LEDGER=private/agent_spend.json
# Website that serves trip.html (the PDF download page the chat links to)
# STUDIO_PAGE_ORIGIN=http://127.0.0.1:8100
