# Copy to .env next to server.py. Only Empathy Studio web-widget values live here; the site has no server credentials.
# Channel browser key from the RSG web channel page in Empathy Studio (acp_...). It is sent from the page by design,
# but kept out of the repository. The channel's Allowed domains must contain this page's exact origin,
# e.g. http://127.0.0.1:8100
STUDIO_CHANNEL_KEY=
STUDIO_SSE_ENDPOINT=https://acp-test.clouding.ai/api/v1/chat
STUDIO_SDK_URL=https://cdn.clouding.ai/sdk/web/next/core.min.js
# Avatar shown by the widget (the supplied snippet's value)
STUDIO_AVATAR_URL=https://i.postimg.cc/TYg4S1HH/image-1794154482438.png

# Appearance is not configured here: paste Studio's Customize -> Copy snippet output into private/studio-widget.snippet.html
# (read on every request). Without that file the widget shows the SDK default look.

# The live backend that records completed bookings; trip.html fetches the booking for the PDF through this server.
RSG_BACKEND_URL=http://127.0.0.1:8110
